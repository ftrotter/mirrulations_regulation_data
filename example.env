MIRRULATIONS_DESTINATION_PATH=/somewhere/on/your/computer/mirrulations/data/
MARKDOWN_DB_PATH=./data/markdown_db/
RCLONE_CONFIG_FILE=./rclone.config

# Stage 3 uses Magentic. Stage 4 uses the official provider SDK directly.
# Set only the providers you intend to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Used by examples/regulation_gov_results/download_examples.py.
REGULATIONS_GOV_API_KEY=

# Sampled Stage 3 review settings used by scripts/stage3_review.py.
# Relative paths are resolved from the repository root. The sample fraction is
# intentionally not stored here; pass it with --sample-fraction for each run.

# Markdown database containing metadata/blocks and Stage 1-3 artifacts.
STAGE3_REVIEW_MARKDOWN_DB=./data/markdown_db

# Immutable Mirrulations source tree whose hash is checked before and after.
STAGE3_REVIEW_SOURCE_ROOT=./data/source/mirrulations

# Stage 3 YAML containing provider, model, prompt versions, and eligibility rules.
STAGE3_REVIEW_CONFIGURATION=./config/structure_discovery.example.yaml

# Directory for manifest.json, source_object_keys.json, and report.json.
STAGE3_REVIEW_OUTPUT_DIRECTORY=./data/markdown_db/metadata/stage3_quality_review_10pct

# Positive integer hard limit on paid segment calls. Leave blank to budget one
# call for every planned segment in the selected cohort.
STAGE3_REVIEW_MAXIMUM_API_CALLS=

# Positive request-start rate. For example, 3 starts at most three calls per
# second, while 0.5 starts one call every two seconds.
STAGE3_REVIEW_REQUESTS_PER_SECOND=3

# Positive integer maximum number of simultaneous paid provider requests.
STAGE3_REVIEW_MAXIMUM_CONCURRENCY=3

# Stage 3 analysis segments are the chunks sent to the model. For content with
# section headings, this positive integer is the maximum blocks per chunk.
STAGE3_REVIEW_MAXIMUM_OWNED_BLOCKS=20

# Positive integer maximum source characters per chunk. A chunk closes when
# this or its applicable block-count limit is reached first. Section boundaries
# also start new chunks, and an individual semantic block is never split.
STAGE3_REVIEW_MAXIMUM_SEGMENT_CHARACTERS=20000

# For documents without section headings, this positive integer replaces
# STAGE3_REVIEW_MAXIMUM_OWNED_BLOCKS as the maximum blocks per chunk.
STAGE3_REVIEW_UNSTRUCTURED_OWNED_BLOCKS=10

# Stage 4 reference linking. Mirrors Stage 3 parallelism and pacing.
# Maximum number of simultaneous paid Stage 4 reference-assessment requests.
STAGE4_REVIEW_MAXIMUM_CONCURRENCY=3

# Positive request-start rate for Stage 4. 0.5 means one call every two seconds.
STAGE4_REVIEW_REQUESTS_PER_SECOND=3

# OpenAI independently grades a deterministic sample of production Stage 4
# outcomes, so the Gemini-generated links are not graded by Gemini.
STAGE4_QUALITY_REVIEW_MARKDOWN_DB=./data/markdown_db

# Review artifacts are isolated here and never overwrite production Stage 4.
STAGE4_QUALITY_REVIEW_OUTPUT_DIRECTORY=./data/markdown_db/metadata/stage4_quality_review_openai_50

# OpenAI model used for structured cross-provider adjudication.
STAGE4_QUALITY_REVIEW_OPENAI_MODEL=gpt-5.2

# Local-only comment browser served by scripts/comment_browser.py.
COMMENT_BROWSER_MARKDOWN_DB=./data/markdown_db
COMMENT_BROWSER_HOST=127.0.0.1
COMMENT_BROWSER_PORT=8765
