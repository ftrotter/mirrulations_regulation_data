MIRRULATIONS_DESTINATION_PATH=/somewhere/on/your/computer/mirrulations/data/
MARKDOWN_DB_PATH=./data/markdown_db/
RCLONE_CONFIG_FILE=./rclone.config

# Stage 3 uses Magentic. Stage 4 uses the official provider SDK directly.
# Set only the providers you intend to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Used by examples/regulation_gov_results/download_examples.py.
REGULATIONS_GOV_API_KEY=

# Sampled Stage 3 review. The sample fraction remains a required CLI argument.
# A blank maximum API call value automatically budgets every selected segment.
STAGE3_REVIEW_MARKDOWN_DB=./data/markdown_db
STAGE3_REVIEW_SOURCE_ROOT=./data/source/mirrulations
STAGE3_REVIEW_CONFIGURATION=./config/structure_discovery.example.yaml
STAGE3_REVIEW_OUTPUT_DIRECTORY=./data/markdown_db/metadata/stage3_quality_review_10pct
STAGE3_REVIEW_MAXIMUM_API_CALLS=
STAGE3_REVIEW_REQUESTS_PER_SECOND=3
STAGE3_REVIEW_MAXIMUM_CONCURRENCY=3
STAGE3_REVIEW_MAXIMUM_OWNED_BLOCKS=20
STAGE3_REVIEW_MAXIMUM_SEGMENT_CHARACTERS=20000
STAGE3_REVIEW_UNSTRUCTURED_OWNED_BLOCKS=10
